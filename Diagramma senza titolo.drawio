        <mxCell id="2LR7KyFRbql_FmaDdAQV-54" value="main_control_process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="440" height="320" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-55" value="Sensitivity: i_clk, i_rst&#xa;&#xa;Operations per state:&#xa;- IDLE: setup base_address&#xa;- READ_K1/K2: read K parameter&#xa;- READ_S: read filter select&#xa;- SET_S: configure filter type&#xa;- LOAD_COEFF: load coefficients array&#xa;- INIT_PROCESSING: initialize processing&#xa;- PROCESSING: 9 phases (0-8)&#xa;  * Phase 0: SETUP&#xa;  * Phase 1: WAIT&#xa;  * Phase 2: LOAD (sliding window)&#xa;  * Phase 3: CALCULATE (convolution)&#xa;  * Phase 4: NORMALIZE (shift approx)&#xa;  * Phase 5-8: WRITE result&#xa;- DONE_STATE: assert o_done" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="350" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-56" value="INTERNAL SIGNALS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="420" height="540" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-57" value="State Signals:&#xa;- current_state: state_type&#xa;- next_state: state_type" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-58" value="Parameters:&#xa;- K: std_logic_vector(15:0)&#xa;- filter_select: std_logic&#xa;- base_address: std_logic_vector(15:0)&#xa;- current_index: integer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="200" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-59" value="Coefficients and Buffer:&#xa;- coefficients: coeff_array(0 to 6)&#xa;- data_window: data_buffer(0 to 6)&#xa;- coeff_counter: integer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="290" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-60" value="Processing Control:&#xa;- processing_phase: integer (0-8)&#xa;- processing_counter: integer&#xa;- buffer_index: integer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="370" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-61" value="Computation:&#xa;- temp_sum: signed(31:0)&#xa;- normalized_result: signed(7:0)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="450" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-62" value="Memory Signals:&#xa;- mem_addr_int: std_logic_vector(15:0)&#xa;- mem_data_out_int: std_logic_vector(7:0)&#xa;- mem_we_int: std_logic&#xa;- mem_en_int: std_logic&#xa;- done_int: std_logic" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="510" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-63" value="FSM STATES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="420" y="680" width="440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="2LR7KyFRbql_FmaDdAQV-64" value="State Machine (state_type):&#xa;&#xa;1. IDLE - Wait for start&#xa;2. READ_K1 - Read K MSB&#xa;3. SETTLE_K1 - Memory settle&#xa;4. READ_K2 - Read K LSB&#xa;5. SETTLE_K2 - Memory settle&#xa;6. READ_S - Read filter select&#xa;7. SETTLE_S - Memory settle&#xa;8. SET_S - Configure filter&#xa;9. SETTLE_PRELOAD - Prepare coeff load&#xa;10. LOAD_COEFF - Load coefficients&#xa;11. SETTLE_COEFF - Memory settle&#xa;12. INIT_PROCESSING - Init processing&#xa;13. PROCESSING - Execute filter&#xa;14. DONE_STATE - Signal completion" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="710" width="420" height="210" as="geometry" />
